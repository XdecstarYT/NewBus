# Digital Workforce server configuration. Copy to .env and edit.
PORT=3000
# Supabase Postgres connection string (Supabase -> Connect -> Session pooler). When set, Supabase is the
# system of record: every change is copied there within seconds and an empty server reloads from it.
DATABASE_URL=
# Local working copy (SQLite file path, created automatically)
DATABASE_PATH=./data/digital-workforce.db
# Seeded OWNER credentials (only used the first time `npm run seed` runs).
# WARNING: "Diddy" is weak and guessable. Change it before going on the internet!
OWNER_ACCOUNT_NUMBER=01
OWNER_PASSWORD=Diddy
# Locked out? Set this to true, restart once (owner password becomes OWNER_PASSWORD), then set it back to false.
OWNER_RESET_PASSWORD=false
# Long random string used to sign things like idempotency/minigame tokens
APP_SECRET=change-me-to-a-long-random-string
# Comma separated list of allowed browser origins (strict CORS). Dev vite origin by default.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Set to true behind HTTPS so cookies get the Secure flag
COOKIE_SECURE=false
# Where automatic backups go, and how many to keep
BACKUP_DIR=./backups
BACKUP_KEEP=10
# Automatic backup every N hours (0 = off)
BACKUP_EVERY_HOURS=6
# Log level: debug | info | warn | error
LOG_LEVEL=info
# Public address when hosted online, e.g. https://my-game.onrender.com (optional on Render)
PUBLIC_URL=
# Demo companies (logins 02-05 / demo1234). Default: on locally, off when NODE_ENV=production
SEED_DEMO=
